# Server settings for the reel bot. Copy to .env and fill in.
# Instagram accounts, tokens and allowed senders go in accounts.toml
# (template: accounts.example.toml).

# Public HTTPS address that forwards to this app (PORT below). No trailing slash.
# Webhook callback URL in Meta = PUBLIC_URL + /webhook
PUBLIC_URL=

# Meta app secret (App settings > Basic). Verifies that webhooks come from Meta.
APP_SECRET=

# Required. Any secret string; must match "Verify token" in the Meta webhook settings.
VERIFY_TOKEN=

# true = download and reply but don't post. Default for all accounts;
# an account can override it with dry_run in accounts.toml.
DRY_RUN=true

PORT=5000

# Folder for downloaded videos. The bot keeps them after dry runs and failed posts.
# A relative path is relative to this project folder. With Docker, this is the folder on
# the host: create it first (mkdir), and on Linux it must be writable by uid 1000.
DOWNLOAD_DIR=downloads

# Optional
# GRAPH_API_VERSION=v27.0
# ACCOUNTS_FILE=accounts.toml
# INSTAGRAM_COOKIES_FILE=cookies.txt
