# Access token. Either an Instagram Login token (IGAA...) or a Facebook / Unified login /
# system user token (EAA...). Needs the Instagram basic, content_publish and manage_messages
# permissions. (ACCOUNT_TOKEN is also accepted as the name.)
ACCESS_TOKEN=

# Instagram account ID (1784...). Optional: found from the token if possible, otherwise
# learned from the first DM webhook (the log prints it so you can paste it here).
IG_ACCOUNT_ID=

# Must match "Verify token" in the Meta App Dashboard webhook settings.
VERIFY_TOKEN=omvrti123

# Public HTTPS address that forwards to this app (port 5000). No trailing slash.
# Webhook callback URL in Meta = PUBLIC_URL + /webhook
PUBLIC_URL=

# Comma-separated Instagram sender IDs allowed to trigger posts (shown in the log
# when they DM the account). Use * to allow anyone (not recommended).
ALLOWED_SENDER_IDS=

# App secret (App settings > Basic for EAA tokens; Instagram app secret for IGAA tokens).
# Used to verify that webhooks really come from Meta. Optional but recommended.
APP_SECRET=

# true = download only, don't publish. Set to false once everything works.
DRY_RUN=true

# Optional
# GRAPH_API_VERSION=v27.0
# PORT=5000
# INSTAGRAM_COOKIES_FILE=cookies.txt
